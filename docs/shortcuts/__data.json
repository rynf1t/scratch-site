{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,31],{"label":3,"items":4},"Start",[5,21],{"title":6,"path":7,"headings":8},"Getting started","/docs/getting-started",[9,12,15,18],{"id":10,"text":11},"open-scratch","Open Scratch",{"id":13,"text":14},"add-five-numbers","Add five numbers",{"id":16,"text":17},"change-the-shortcuts","Change the shortcuts",{"id":19,"text":20},"choose-the-look-and-motion","Choose the look and motion",{"title":22,"path":23,"headings":24},"Keyboard Shortcuts","/docs/shortcuts",[25,28],{"id":26,"text":27},"switch-sheets","Switch sheets",{"id":29,"text":30},"nudge-a-number-or-date","Nudge a number or date",{"label":32,"items":33},"Guides",[34,113,129,166,182,192],{"title":35,"path":36,"headings":37},"Grid and shortcuts","/docs/grid",[38,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101,104,107,110],{"id":39,"text":40},"grid-toolbar","Grid toolbar",{"id":42,"text":43},"move-and-select","Move and select",{"id":45,"text":46},"complete-a-formula","Complete a formula",{"id":48,"text":49},"select-separate-ranges","Select separate ranges",{"id":51,"text":52},"save-a-named-range","Save a named range",{"id":54,"text":55},"named-tables","Named tables",{"id":57,"text":58},"add-borders-or-style-a-table","Add borders or style a table",{"id":60,"text":61},"duplicate-a-sheet-or-import-a-file","Duplicate a sheet or import a file",{"id":63,"text":64},"insert-or-delete-rows-and-columns","Insert or delete rows and columns",{"id":66,"text":67},"move-hide-or-resize-rows-and-columns","Move, hide or resize rows and columns",{"id":69,"text":70},"freeze-rows-and-columns","Freeze rows and columns",{"id":72,"text":73},"sort-rows","Sort rows",{"id":75,"text":76},"filter-rows","Filter rows",{"id":78,"text":79},"resize-the-window","Resize the window",{"id":81,"text":82},"move-or-detach-panes","Move or detach panes",{"id":84,"text":85},"open-a-sheet-in-its-own-window","Open a sheet in its own window",{"id":87,"text":88},"drag-out-a-table-or-export-csv","Drag out a table or export CSV",{"id":90,"text":91},"copy-a-range-for-another-app","Copy a range for another app",{"id":93,"text":94},"workbooks-and-sheet-archive","Workbooks and sheet archive",{"id":96,"text":97},"tsv-and-excel-files","TSV and Excel files",{"id":99,"text":100},"preview-paste-and-fill","Preview paste and fill",{"id":102,"text":103},"format-a-range","Format a range",{"id":105,"text":106},"calculate-and-copy","Calculate and copy",{"id":108,"text":109},"work-across-sheets","Work across sheets",{"id":111,"text":112},"check-inputs-as-you-edit","Check inputs as you edit",{"title":114,"path":115,"headings":116},"Capture and paste","/docs/capture",[117,120,123,126],{"id":118,"text":119},"capture-amounts","Capture amounts",{"id":121,"text":122},"read-a-screenshot","Read a screenshot",{"id":124,"text":125},"choose-how-to-paste","Choose how to paste",{"id":127,"text":128},"fill-a-series","Fill a series",{"title":130,"path":131,"headings":132},"Notes and Obsidian","/docs/notes-and-obsidian",[133,136,139,142,145,148,151,154,157,160,163],{"id":134,"text":135},"move-notes","Move Notes",{"id":137,"text":138},"resize-notes","Resize Notes",{"id":140,"text":141},"format-a-note","Format a note",{"id":143,"text":144},"annotate-a-cell-or-range","Annotate a cell or range",{"id":146,"text":147},"put-a-live-result-in-a-note","Put a live result in a note",{"id":149,"text":150},"repair-a-note-link","Repair a note link",{"id":152,"text":153},"send-the-table-and-notes","Send the table and notes",{"id":155,"text":156},"save-a-dated-sheet-note","Save a dated sheet note",{"id":158,"text":159},"edit-a-table-in-both-scratch-and-obsidian","Edit a table in both Scratch and Obsidian",{"id":161,"text":162},"open-an-export-in-scratch","Open an export in Scratch",{"id":164,"text":165},"search-your-obsidian-vault","Search your Obsidian vault",{"title":167,"path":168,"headings":169},"Formula Microscope","/docs/formula-microscope",[170,173,176,179],{"id":171,"text":172},"read-a-calculation","Read a calculation",{"id":174,"text":175},"find-a-cell-behind-an-error","Find a cell behind an error",{"id":177,"text":178},"match-formula-references-to-the-grid","Match formula references to the grid",{"id":180,"text":181},"see-where-a-pinned-result-came-from","See where a pinned result came from",{"title":183,"path":184,"headings":185},"Selection History","/docs/history",[186,189],{"id":187,"text":188},"compare-a-revision","Compare a revision",{"id":190,"text":191},"restore-just-the-range","Restore just the range",{"title":193,"path":194,"headings":195},"Record and Replay","/docs/replay",[196],{"id":197,"text":198},"try-it-on-another-range","Try it on another range"],"uses":{}},{"type":"data","data":[{"doc":1,"prev":7,"next":10},{"title":2,"description":3,"html":4,"path":5,"group":6},"Keyboard Shortcuts","Choose your own shortcuts for Notes, the command palette and capture.","\u003Cp>\u003Cstrong>Click the ⋯ button in Scratch and open Keyboard Shortcuts.\u003C/strong> Choose a \u003Cstrong>Change\u003C/strong> command and press the combination you want. Press Escape to cancel, or choose \u003Cstrong>Reset\u003C/strong> in the menu to restore a default.\u003C/p>\n\u003Cdiv class=\"table edge wide\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth scope=\"col\">Action\u003C/th>\u003Cth scope=\"col\">Default\u003C/th>\u003Cth scope=\"col\">Where it works\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>Open Scratch\u003C/td>\u003Ctd>⌥ Space\u003C/td>\u003Ctd>From any app\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Capture Clipboard\u003C/td>\u003Ctd>⌥⇧ Space\u003C/td>\u003Ctd>From any app\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Show or Hide Notes\u003C/td>\u003Ctd>⌘J\u003C/td>\u003Ctd>In Scratch\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Command Palette\u003C/td>\u003Ctd>⇧⌘P\u003C/td>\u003Ctd>In Scratch\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Focus Notes or Grid\u003C/td>\u003Ctd>⌥⌘J\u003C/td>\u003Ctd>In Scratch\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Send to Obsidian\u003C/td>\u003Ctd>⇧⌘J\u003C/td>\u003Ctd>In Scratch\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Find a Sheet\u003C/td>\u003Ctd>⌘K\u003C/td>\u003Ctd>In Scratch\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Next or Previous Sheet\u003C/td>\u003Ctd>⌃Tab or ⌃⇧Tab\u003C/td>\u003Ctd>In Scratch\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Nudge Cell Up or Down\u003C/td>\u003Ctd>⌃⌥↑ or ⌃⌥↓\u003C/td>\u003Ctd>On the grid\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>If another app intercepts a shortcut, click \u003Cstrong>Notes\u003C/strong> or choose \u003Cstrong>Command Palette\u003C/strong> from the ⋯ menu while you change the binding. For example, try ⌃⌥N for Notes and ⌃⌥P for the palette if those combinations are available on your Mac. Scratch flags conflicts with its own shortcuts.\u003C/p>\n\u003Cp>Open the command palette and type \u003Cstrong>Freeze\u003C/strong>, \u003Cstrong>Sort Rows\u003C/strong>, \u003Cstrong>Filter Rows\u003C/strong> or \u003Cstrong>Clear Row Filter\u003C/strong>. Tab moves through the sort and filter controls. In Sort, adjust \u003Cstrong>Rows to move\u003C/strong> when needed, choose an order, and click \u003Cstrong>Apply Sort\u003C/strong>. In Filter, type to update the results and press Return to keep them. Press Escape to cancel the preview. \u003Ca href=\"/docs/grid#freeze-rows-and-columns\">Grid and shortcuts\u003C/a>.\u003C/p>\n\u003Cp>Use \u003Cstrong>Dock Notes Left\u003C/strong>, \u003Cstrong>Dock Notes Right\u003C/strong>, \u003Cstrong>Dock Notes Top\u003C/strong>, \u003Cstrong>Dock Notes Bottom\u003C/strong> or \u003Cstrong>Detach Notes\u003C/strong> in the command palette to arrange the workspace from the keyboard. ⌥⌘J also switches focus between the floating windows. \u003Ca href=\"/docs/grid#move-or-detach-panes\">Move or detach panes\u003C/a>.\u003C/p>\n\u003Cp>Choose \u003Cstrong>Tables\u003C/strong> in the command palette to find a table or its actions. \u003Cstrong>Create Table from Selection\u003C/strong> goes straight to naming. With a cell in a named table selected, \u003Cstrong>Sort Rows\u003C/strong> and \u003Cstrong>Filter Rows\u003C/strong> use that table. \u003Ca href=\"/docs/grid#named-tables\">Named tables\u003C/a>.\u003C/p>\n\u003Cp>Use \u003Cstrong>Hide Selected Rows\u003C/strong>, \u003Cstrong>Hide Selected Columns\u003C/strong>, \u003Cstrong>Show All Rows\u003C/strong>, \u003Cstrong>Show All Columns\u003C/strong> or \u003Cstrong>Fit Row Height\u003C/strong> in the command palette. Option-drag a row or column header to move it. \u003Ca href=\"/docs/grid#move-hide-or-resize-rows-and-columns\">Move, hide or resize rows and columns\u003C/a>.\u003C/p>\n\u003Cp>Find \u003Cstrong>New Workbook\u003C/strong>, \u003Cstrong>Open Workbook\u003C/strong>, \u003Cstrong>Open Default Workbook\u003C/strong>, \u003Cstrong>Archive Current Sheet\u003C/strong>, \u003Cstrong>Import Excel Values\u003C/strong> and TSV export in the command palette. \u003Ca href=\"/docs/grid#workbooks-and-sheet-archive\">Workbooks and sheet archive\u003C/a>.\u003C/p>\n\u003Ch2 id=\"switch-sheets\">Switch sheets\u003Ca class=\"anchor\" href=\"#switch-sheets\" aria-label=\"Link to this section\">\u003Csvg viewBox=\"0 0 16 16\" width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" aria-hidden=\"true\">\u003Cpath d=\"M6.5 9.5a2.8 2.8 0 0 0 4 0l2.2-2.2a2.8 2.8 0 0 0-4-4l-.7.7\"/>\u003Cpath d=\"M9.5 6.5a2.8 2.8 0 0 0-4 0L3.3 8.7a2.8 2.8 0 0 0 4 4l.7-.7\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp>Press ⌘K or choose \u003Cstrong>Switch Sheet\u003C/strong> in the command palette. The last sheets you visited in this workbook appear first, with the cell you left selected on each. Press Return to reopen the first result, or type part of a sheet name. Use the arrows to highlight a result and Escape to return to your current sheet.\u003C/p>\n\u003Cp>Press ⌃Tab to move forward in workbook order or ⌃⇧Tab to move backward. Both wrap around and skip archived sheets. ⌘1 through ⌘9 still jump to sheets in workbook order. Click the sheet title to find actions such as Rename and Export.\u003C/p>\n\u003Cfigure class=\"scratch-media\">\n\u003Cimg class=\"scratch-light\" src=\"/docs/sheet-switcher-light.webp\" alt=\"The sheet switcher lists Coast trip with its last selected cell and marks November budget as the current sheet.\" width=\"1120\" height=\"690\" loading=\"lazy\" decoding=\"async\">\n\u003Cimg class=\"scratch-dark\" src=\"/docs/sheet-switcher-dark.webp\" alt=\"The sheet switcher lists Coast trip with its last selected cell and marks November budget as the current sheet.\" width=\"1120\" height=\"690\" loading=\"lazy\" decoding=\"async\">\n\u003C/figure>\u003Ch2 id=\"nudge-a-number-or-date\">Nudge a number or date\u003Ca class=\"anchor\" href=\"#nudge-a-number-or-date\" aria-label=\"Link to this section\">\u003Csvg viewBox=\"0 0 16 16\" width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" aria-hidden=\"true\">\u003Cpath d=\"M6.5 9.5a2.8 2.8 0 0 0 4 0l2.2-2.2a2.8 2.8 0 0 0-4-4l-.7.7\"/>\u003Cpath d=\"M9.5 6.5a2.8 2.8 0 0 0-4 0L3.3 8.7a2.8 2.8 0 0 0 4 4l.7-.7\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp>Select a cell on the grid and press ⌃⌥↑ or ⌃⌥↓. A number moves by one, a date by one day and a percentage by one percentage point. Hold Shift for ten, one week or ten percentage points.\u003C/p>\n\u003Cp>Dependent formulas update as you hold the key. Release it and press ⌘Z to undo the full adjustment. Select a formula’s input cell to adjust the result. \u003Cstrong>Nudge Cell Up\u003C/strong> and \u003Cstrong>Nudge Cell Down\u003C/strong> are also in the command palette.\u003C/p>\n\u003Cfigure class=\"scratch-media\">\n\u003Cimg class=\"scratch-light\" src=\"/docs/cell-nudge-light.webp\" alt=\"The command palette shows Nudge Cell Up and Nudge Cell Down with their keyboard shortcuts.\" width=\"547\" height=\"327\" loading=\"lazy\" decoding=\"async\">\n\u003Cimg class=\"scratch-dark\" src=\"/docs/cell-nudge-dark.webp\" alt=\"The command palette shows Nudge Cell Up and Nudge Cell Down with their keyboard shortcuts.\" width=\"547\" height=\"327\" loading=\"lazy\" decoding=\"async\">\n\u003C/figure>\u003Cfigure class=\"scratch-media\">\n\u003Cimg class=\"scratch-light\" src=\"/docs/palette-shortcuts-light.webp\" alt=\"The command palette shows formatting actions with their keyboard shortcuts.\" width=\"1280\" height=\"840\" loading=\"lazy\" decoding=\"async\">\n\u003Cimg class=\"scratch-dark\" src=\"/docs/palette-shortcuts-dark.webp\" alt=\"The command palette shows formatting actions with their keyboard shortcuts.\" width=\"1280\" height=\"840\" loading=\"lazy\" decoding=\"async\">\n\u003C/figure>\n","/docs/shortcuts","Start",{"title":8,"path":9},"Record and Replay","/docs/replay",null],"uses":{"params":["page"]}}]}
